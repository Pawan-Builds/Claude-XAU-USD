# === TRADING MODE ===
# Select: DEMO or LIVE
# Change this setting and restart the application
TRADING_MODE=DEMO

# === DEMO ACCOUNT CREDENTIALS ===
# XM MT5 Demo account credentials
# Password must not contain special YAML characters (@ # % ^ & * etc.)
DEMO_MT5_LOGIN=
DEMO_MT5_PASSWORD=  # e.g. Xmtrading23 (no @ or other special chars)
DEMO_MT5_SERVER=XMGlobal-MT5 5
DEMO_MT5_PATH=C:\Program Files\XAUUSD\terminal64.exe

# === LIVE ACCOUNT CREDENTIALS ===
# XM MT5 Live account credentials
# CRITICAL: LIVE_TRADING_ENABLED must be false initially
# Set LIVE_TRADING_ENABLED=true only after explicit confirmation
LIVE_MT5_LOGIN=
LIVE_MT5_PASSWORD=
LIVE_MT5_SERVER=XMGlobal-MT5 5
LIVE_MT5_PATH=C:\Program Files\XAUUSD\terminal64.exe

# LIVE TRADING SAFETY ACTIVATION
# ALL of the following MUST be true for LIVE trading:
# - TRADING_MODE=LIVE
# - LIVE_TRADING_ENABLED=true
# - LIVE_ALLOWED_ACCOUNT matches actual MT5 account number
LIVE_TRADING_ENABLED=false
LIVE_ALLOWED_ACCOUNT=

# TELEGRAM
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=6965789476

# TRADING CONFIGURATION
RISK_PERCENT=2.0
MIN_RISK_REWARD=2.0

# DASHBOARD
DASHBOARD_HOST=127.0.0.1
DASHBOARD_PORT=8000
DASHBOARD_SECRET_KEY=change_this_in_production